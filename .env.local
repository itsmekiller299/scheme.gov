# 3) Restart: npm run dev
# 4) Verify: curl http://localhost:3000/api/ai/verify | python3 -m json.tool  → should show "live": true
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
