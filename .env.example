# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/hackathon-ai-welfare
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/hackathon-ai-welfare
MONGODB_URI=mongodb://127.0.0.1:27017/hackathon-ai-welfare

# Auth — change in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-prod-please-use-64-hex-chars

# Gemini — REQUIRED for live unlock (get at https://aistudio.google.com/app/apikey → Create API key)
# 1) Copy key (AIza... ~39 chars) 2) Replace below ENTIRELY (no xxxx) 3) Restart: npm run dev 4) Verify: GET /api/ai/verify
# Without real key, app runs in demo rule-based mode (still demoable).
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Alternative env name: GOOGLE_API_KEY (same effect) — also accepts AQ.... keys (new style, len 53)
# Optional: GEMINI_MODEL=gemini-flash-latest (recommended, fallback: gemini-3-flash-preview, gemini-3.6-flash). gemini-2.0-flash retired; gemini-2.5-flash soon retired.
# Optional: GEMINI_EMBEDDING_MODEL=gemini-embedding-001 (text-embedding-004 retired)
# Optional seed protection (used as header x-seed-secret for POST /api/seed)
SEED_SECRET=change-me-seed-secret
